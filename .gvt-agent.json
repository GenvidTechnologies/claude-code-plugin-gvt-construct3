{
  "repo": {
    "default_branch": "main",
    "host": "github"
  },
  "commands": {
    "validate": "cd plugin && claude plugin validate . && node --test skills/*/scripts/test/*.test.mjs"
  },
  "paths": {
    "plugin_root": "plugin",
    "docs/TOC.md": "wiki/index.md",
    "docs/decisions/": "wiki/decisions/",
    "docs/issue-triage.md": "wiki/process/issue-triage.md",
    "docs/wiki-schema.md": "wiki/wiki-schema.md"
  },
  "wiki": {
    "wikiDir": "wiki",
    "rawDir": "raw"
  },
  "hygiene": {
    "excludePaths": ["raw/", "wiki/decisions/"]
  },
  "bugTracker": {
    "kind": "github",
    "actionQuery": "gh issue list --state open -L 200 --json number,title,labels,body,assignees",
    "comparisonQuery": "gh issue list --state all -L 500 --json number,title,labels,state",
    "readOne": "gh issue view {id} --json number,title,body,labels,comments",
    "triagedLabel": "triaged",
    "needsInfoLabel": "question"
  }
}
